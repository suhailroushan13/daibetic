SITE_URL=https://diabetesguide.live

# Google Search Console "HTML tag" verification token (the content="..." value only).
GOOGLE_SITE_VERIFICATION=

# Upstash Redis for the live visitor count. Added automatically by the Vercel integration;
# run `vercel env pull .env.local` to use them locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=
