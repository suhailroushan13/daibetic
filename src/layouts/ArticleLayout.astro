---
import type {CollectionEntry} from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import SourceCard from '../components/mdx/SourceCard.astro';
import RelatedTopics from '../components/mdx/RelatedTopics.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import {categories} from '../data/navigation';
import {getArticles,formatDate} from '../lib/content';
interface Props {article:CollectionEntry<'research'>;headings:{depth:number;slug:string;text:string}[]}
const {article,headings}=Astro.props;const d=article.data;
const category=categories.find(c=>c.key===d.category)!;
const articles=await getArticles();const index=articles.findIndex(a=>a.id===article.id);const prev=articles[index-1];const next=articles[index+1];
const url=new URL(`/${d.slug}`,Astro.site).href;
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:d.title,description:d.description,url,datePublished:d.datePublished.toISOString(),dateModified:d.dateModified.toISOString(),author:{'@type':'Organization',name:d.author},publisher:{'@type':'Organization',name:'Glucose Atlas'},mainEntityOfPage:url},{'@type':'BreadcrumbList',itemListElement:[{name:'Home',item:new URL('/',Astro.site).href},{name:category.label,item:new URL(`/${category.key}`,Astro.site).href},{name:d.title,item:url}].map((item,i)=>({'@type':'ListItem',position:i+1,...item}))}]};
---
<BaseLayout title={d.title} description={d.description} article jsonld={jsonld}><ReadingProgress/><div class="page-shell"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Library</a><Icon name="chevron" size={10}/><a href={`/${category.key}`}>{category.label}</a><Icon name="chevron" size={10}/><span>{d.title}</span></nav><div class="article-layout"><article class="article-main" data-pagefind-body>
 <header><a class="eyebrow" href={`/${category.key}`} data-pagefind-filter="category" data-pagefind-meta="category">{category.label}</a><h1 class="page-title" data-pagefind-meta="title">{d.title}</h1><p class="page-description" data-pagefind-meta="description">{d.description}</p><div class="article-meta"><span data-pagefind-filter="difficulty" data-pagefind-meta="difficulty">{d.difficulty}</span><span><Icon name="clock" size={13}/>{d.readingTime} min read</span><span><Icon name="file" size={13}/>{d.sources.length} sources</span><span data-pagefind-meta="evidence"><EvidenceBadge level={d.evidenceLevel}/></span></div><div class="article-byline">{d.author} · Updated {formatDate(d.dateModified)} · Source check {formatDate(d.reviewedDate)}</div></header>
 <details class="mobile-toc" data-pagefind-ignore><summary>On this page</summary><nav aria-label="Article contents">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>
 <div class="prose"><slot/></div>
 <div class="source-list" id="references" data-pagefind-ignore><span class="eyebrow">TRACE THE EVIDENCE</span><h2>Sources & further reading</h2>{d.sources.map((id,i)=><SourceCard id={id} number={i+1}/>)}<p class="article-notice">Source checking is an editorial literature check, not independent clinical review. This page is educational and cannot establish a diagnosis or treatment plan. Evidence labels describe the cited claims; they do not grade the entire topic uniformly.</p></div>
 <div data-pagefind-ignore><RelatedTopics slugs={d.relatedTopics}/><nav class="prev-next" aria-label="Previous and next articles">{prev ? <a href={`/${prev.data.slug}`}><span>← Previous research</span>{prev.data.title}</a>:<div/>}{next && <a href={`/${next.data.slug}`}><span>Next research →</span>{next.data.title}</a>}</nav></div>
 </article><aside class="article-toc" aria-label="On this page"><h2>ON THIS PAGE</h2><nav>{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} class:list={[{'toc-nested':h.depth===3}]}>{h.text}</a>)}<a href="#references">Sources & further reading</a></nav><div class="toc-footer"><EvidenceBadge level={d.evidenceLevel}/><p class="article-notice">Last checked<br/>{formatDate(d.reviewedDate)}<br/><br/>Educational research.<br/>Not medical advice.</p></div></aside></div></div></BaseLayout>
