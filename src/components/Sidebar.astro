---
import { categories } from '../data/navigation';
import Icon from './Icon.astro';
import { getArticles } from '../lib/content';
const path = Astro.url.pathname;
const articles = await getArticles();
---
<aside class="sidebar" id="library-navigation" aria-label="Research library">
  <a href="/search" class="sidebar-search" data-open-search><Icon name="search" size={17}/><span>Search the library</span><kbd>⌘ K</kbd></a>
  <nav aria-label="Main navigation">
    <a href="/" class:list={['nav-item', {active:path==='/'}]} aria-current={path==='/' ? 'page' : undefined}><Icon name="home" size={18}/>Overview</a>
    <a href="/learn" class:list={['nav-item', {active:path==='/learn'}]}><Icon name="book" size={18}/>Start here<span class="nav-new">GUIDE</span></a>
    <div class="nav-label">THE RESEARCH LIBRARY</div>
    {categories.map(cat => <div>
      <a href={`/${cat.key}`} class:list={['nav-item', {active:path===`/${cat.key}` || path.startsWith(`/${cat.key}/`)}]} aria-current={path===`/${cat.key}` ? 'page' : undefined}><Icon name={cat.icon} size={18}/>{cat.short==='Learn' ? 'The fundamentals' : cat.label}</a>
      {path.startsWith(`/${cat.key}/`) && <div class="subnav">{articles.filter(a=>a.data.category===cat.key).map(a=><a href={`/${a.data.slug}`} aria-current={path===`/${a.data.slug}` ? 'page':undefined}>{a.data.title}</a>)}</div>}
    </div>)}
    <div class="nav-label">EXPLORE FURTHER</div>
    <a href="/research" class:list={['nav-item',{active:path==='/research'}]}><Icon name="flask" size={18}/>Research index <span class="tiny-dot"></span></a>
    <a href="/glossary" class="nav-item"><Icon name="book" size={18}/>Glossary</a>
    <a href="/sources" class="nav-item"><Icon name="file" size={18}/>Sources & evidence</a>
    <a href="/about" class="nav-item"><Icon name="globe" size={18}/>About the project</a>
  </nav>
  <div class="sidebar-note"><span class="tiny-dot"></span> Open knowledge. Clear evidence.<p>Built for curiosity.<br/>Grounded in science.</p></div>
</aside>
