---
import Icon from './Icon.astro';
---
<dialog id="search-dialog" aria-labelledby="search-dialog-title">
  <div class="search-dialog-top"><h2 id="search-dialog-title">Search the research</h2><button class="icon-button" data-close-search aria-label="Close search"><Icon name="close"/></button></div>
  <form action="/search" class="search-form" role="search"><label for="palette-query" class="sr-only">Search the research library</label><Icon name="search"/><input id="palette-query" name="q" type="search" placeholder="Try “insulin resistance” or “remission”…" autocomplete="off"/><kbd>ESC</kbd></form>
  <div class="search-status" id="palette-status" role="status">Search concepts, biology, therapies, and sources.</div>
  <div id="palette-results" class="search-results"></div>
  <div class="search-footer"><span>↑ ↓ Navigate &nbsp; ↵ Open</span><a href="/search">Advanced search →</a></div>
</dialog>
<script>
  import { initializeSearch } from '../lib/search';
  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#palette-query');
  let previousFocus: HTMLElement | null = null;
  function openSearch() { if (!dialog || dialog.open) return; previousFocus = document.activeElement as HTMLElement; dialog.showModal(); input?.focus(); }
  document.querySelectorAll('[data-open-search]').forEach(button=>button.addEventListener('click', e=>{e.preventDefault();openSearch();}));
  document.addEventListener('keydown',e=>{if((e.metaKey || e.ctrlKey) && e.key.toLowerCase()==='k'){e.preventDefault();if(dialog?.open)dialog.close();else openSearch();}});
  document.querySelector('[data-close-search]')?.addEventListener('click',()=>dialog?.close());
  dialog?.addEventListener('click',e=>{if(e.target===dialog){const box=dialog.getBoundingClientRect();if(e.clientX<box.left||e.clientX>box.right||e.clientY<box.top||e.clientY>box.bottom)dialog.close();}});
  dialog?.addEventListener('close',()=>previousFocus?.focus());
  initializeSearch('palette-query','palette-results','palette-status');
</script>
