---
import Icon from '../Icon.astro';
import Logo from './Logo.astro';
import { categories, categoryGroups } from '../../data/navigation';
import { learningPath } from '../../data/guide';
import { getArticles } from '../../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const articles = await getArticles();
const current = articles.find((a) => `/${a.data.slug}` === path);
const activeCategory = current?.data.category ?? categories.find((c) => path === `/${c.key}`)?.key;
const top = [
  { href: '/', label: 'Overview', icon: 'home' },
  { href: '/learn', label: 'Start the guide', icon: 'guide', badge: `${learningPath.length} steps` },
  { href: '/report', label: 'The full report', icon: 'book-text' },
];
const reference = [
  { href: '/research', label: 'Research index', icon: 'library' },
  { href: '/glossary', label: 'Glossary', icon: 'book' },
  { href: '/sources', label: 'Sources & evidence', icon: 'file' },
  { href: '/about', label: 'Our approach', icon: 'compass' },
];
---
<aside id="library-navigation" class="app-sidebar" aria-label="Library navigation">
  <div class="flex h-14 shrink-0 items-center gap-2 px-3">
    <a href="/" class="flex min-w-0 flex-1 items-center gap-2.5 rounded-md p-1 transition-colors hover:bg-sidebar-accent">
      <Logo size={30} />
      <span class="grid min-w-0 leading-tight">
        <span class="truncate text-sm font-semibold tracking-tight">Glucose Atlas</span>
        <span class="truncate text-xs text-muted-foreground">The diabetes knowledge project</span>
      </span>
    </a>
    <button id="menu-close" type="button" class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-sidebar-accent hover:text-foreground lg:hidden" aria-label="Close navigation">
      <Icon name="close" size={16} />
    </button>
  </div>

  <div class="px-3 pb-2">
    <a href="/search" data-open-search class="flex h-9 w-full items-center gap-2 rounded-md border bg-background px-2.5 text-sm text-muted-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground dark:bg-input/30">
      <Icon name="search" size={15} />
      <span>Search the library</span>
      <kbd data-kbd class="ml-auto inline-flex h-5 items-center rounded border bg-muted px-1.5 text-[0.6875rem] font-medium text-muted-foreground">⌘K</kbd>
    </a>
  </div>

  <nav data-sidebar-scroll class="sidebar-scroll flex-1 overflow-y-auto overscroll-contain px-3 pb-6" aria-label="Main navigation">
    <div class="px-2 pt-3 pb-1.5 text-xs font-medium text-muted-foreground">Get started</div>
    <ul class="flex flex-col gap-0.5">
      {top.map((item) => (
        <li>
          <a href={item.href} class="nav-link" aria-current={path === item.href ? 'page' : undefined}>
            <Icon name={item.icon} />
            <span class="truncate">{item.label}</span>
            {item.badge && <span class="ml-auto rounded-md border bg-background px-1.5 py-px text-[0.6875rem] font-medium text-muted-foreground">{item.badge}</span>}
          </a>
        </li>
      ))}
    </ul>

    {categoryGroups.map((group) => (
      <div>
        <div class="px-2 pt-5 pb-1.5 text-xs font-medium text-muted-foreground">{group.label}</div>
        <ul class="flex flex-col gap-0.5">
          {categories.filter((c) => c.group === group.key).map((cat) => {
            const items = articles.filter((a) => a.data.category === cat.key);
            const active = activeCategory === cat.key;
            return (
              <li>
                <details class="nav-group animate-details" open={active}>
                  <summary class="nav-link" data-active={active ? 'true' : undefined}>
                    <Icon name={cat.icon} />
                    <span class="truncate">{cat.label}</span>
                    <Icon name="chevron" size={14} class="nav-chevron ml-auto" />
                  </summary>
                  <div class="nav-sub">
                    <a href={`/${cat.key}`} aria-current={path === `/${cat.key}` ? 'page' : undefined}>All {items.length} topics</a>
                    {items.map((a) => (
                      <a href={`/${a.data.slug}`} aria-current={path === `/${a.data.slug}` ? 'page' : undefined}>{a.data.title}</a>
                    ))}
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </div>
    ))}

    <div class="px-2 pt-5 pb-1.5 text-xs font-medium text-muted-foreground">Reference</div>
    <ul class="flex flex-col gap-0.5">
      {reference.map((item) => (
        <li>
          <a href={item.href} class="nav-link" aria-current={path === item.href ? 'page' : undefined}>
            <Icon name={item.icon} />
            <span class="truncate">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="shrink-0 border-t p-3">
    <a href="/learn" class="block rounded-lg border bg-background p-3 shadow-xs transition-colors hover:bg-accent dark:bg-input/20">
      <span class="flex items-center justify-between text-xs font-medium">
        <span>Your guide progress</span>
        <span class="tabular text-muted-foreground" data-sidebar-progress-label>0 / {learningPath.length}</span>
      </span>
      <span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-muted">
        <span data-sidebar-progress-bar class="block h-full w-0 rounded-full bg-foreground transition-[width] duration-700"></span>
      </span>
      <span class="mt-2 block text-xs text-muted-foreground">Educational research · not medical advice</span>
    </a>
  </div>
</aside>
<script is:inline>
  (function () {
    var nav = document.querySelector('[data-sidebar-scroll]');
    if (!nav) return;
    try { var saved = sessionStorage.getItem('atlas-sidebar-scroll'); if (saved) nav.scrollTop = Number(saved); } catch (e) {}
    var active = nav.querySelector('.nav-sub a[aria-current="page"], .nav-link[aria-current="page"]');
    if (active) {
      var a = active.getBoundingClientRect(), n = nav.getBoundingClientRect();
      if (a.top < n.top || a.bottom > n.bottom) nav.scrollTop += a.top - n.top - n.height / 3;
    }
    addEventListener('pagehide', function () { try { sessionStorage.setItem('atlas-sidebar-scroll', String(nav.scrollTop)); } catch (e) {} });
  })();
</script>
