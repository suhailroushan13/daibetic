---
interface Props { class?: string; size?: number }
const { class: className, size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class:list={['shrink-0', className]}>
  <rect width="32" height="32" rx="8" fill="var(--foreground)" />
  <path d="M16 7.25 23.6 11.6v8.8L16 24.75 8.4 20.4v-8.8Z" fill="none" stroke="var(--background)" stroke-width="2" stroke-linejoin="round" />
  <circle cx="16" cy="16" r="2.5" fill="var(--background)" />
</svg>
