---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getArticles} from '../lib/content';
import {categories} from '../data/navigation';
const articles=await getArticles();
---
<BaseLayout title="Research index" description="Browse every sourced diabetes research page by topic, evidence, difficulty, or research status. A connected encyclopedia from biology to emerging therapies."><div class="page-shell"><span class="eyebrow">THE CONNECTED ENCYCLOPEDIA</span><h1 class="page-title">Follow the research.</h1><p class="page-description">{articles.length} independently addressable topics. One connected picture.</p><div class="research-tabs" role="group" aria-label="Research collection"><button aria-pressed="true" data-index-tab="all">All topics</button><button aria-pressed="false" data-index-tab="recent">Recently updated</button><button aria-pressed="false" data-index-tab="core">Core concepts</button><button aria-pressed="false" data-index-tab="strong">Strong evidence</button><button aria-pressed="false" data-index-tab="emerging">Emerging research</button><button aria-pressed="false" data-index-tab="future">Future technologies</button><button aria-pressed="false" data-index-tab="popular">Most read</button></div><p id="no-popularity" class="unmeasured" hidden>Reading popularity is not measured. No “most read” ranking is available; explore the editorial Core Concepts selection instead.</p><div class="filter-bar"><label>Find a topic<input id="index-query" type="search" placeholder="Filter by title…"/></label><label>Research area<select id="index-category"><option value="">All areas</option>{categories.map(c=><option value={c.key}>{c.label}</option>)}</select></label><label>Explanation level<select id="index-difficulty"><option value="">All levels</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></label></div><p id="index-count" class="filter-count" role="status">{articles.length} topics</p><div class="article-index" id="article-index">{articles.map(article=><ArticleCard article={article}/>)}</div><p class="no-results" id="index-empty" hidden>No topics match those filters.</p></div><script>
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-article-category]'));let tab='all';const q=document.querySelector<HTMLInputElement>('#index-query')!;const category=document.querySelector<HTMLSelectElement>('#index-category')!;const difficulty=document.querySelector<HTMLSelectElement>('#index-difficulty')!;
function filter(){let count=0;cards.forEach(c=>{const d=c.dataset;const inTab=tab==='all'||tab==='recent'||(tab==='core'&&d.featured==='true')||(tab==='strong'&&['Established','Strong Evidence'].includes(d.articleEvidence||''))||(tab==='emerging'&&['Preliminary','Experimental','Limited Evidence'].includes(d.articleEvidence||''))||(tab==='future'&&d.articleCategory==='future');const show=inTab&&(!category.value||d.articleCategory===category.value)&&(!difficulty.value||d.articleDifficulty===difficulty.value)&&(d.articleTitle||'').includes(q.value.toLowerCase());c.hidden=!show;if(show)count++;});document.getElementById('index-count')!.textContent=`${count} topics${tab==='recent'?' · all checked 30 September 2026':''}`;document.getElementById('index-empty')!.hidden=count>0||tab==='popular';document.getElementById('no-popularity')!.hidden=tab!=='popular';}
[q,category,difficulty].forEach(el=>el.addEventListener('input',filter));document.querySelectorAll<HTMLButtonElement>('[data-index-tab]').forEach(b=>b.addEventListener('click',()=>{tab=b.dataset.indexTab!;document.querySelectorAll('[data-index-tab]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter();}));
</script></BaseLayout>
