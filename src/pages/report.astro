---
import BaseLayout from '../layouts/BaseLayout.astro';
import {reportParts} from '../data/report';
import {getArticles} from '../lib/content';
const articles=await getArticles();
---
<BaseLayout title="The diabetes research report in 18 parts" description="Read the complete connected research sequence: human glucose biology, disease development, detection, prevention, treatment, remission, and future research."><div class="page-shell"><span class="eyebrow">THE LONG VIEW · 18 PARTS</span><h1 class="page-title">From a molecule<br/>to a research frontier.</h1><p class="page-description">An ordered reading companion to the library. Each chapter is a small, independently linked research page with its own sources.</p><div class="hero-buttons"><a href="/fundamentals/mental-model" class="button button-primary">Read the one-page mental model →</a><a href="/report.md" class="button" download>Download the research report</a></div><div class="learning-list">{reportParts.map((part,i)=><section class="report-part"><span class="eyebrow">PART {String(i+1).padStart(2,'0')}</span><h2>{part.title}</h2><ul>{part.slugs.map(slug=><li><a href={`/${slug}`}>{articles.find(a=>a.data.slug===slug)?.data.title} →</a></li>)}</ul></section>)}</div><p class="page-description">What we know, what we strongly suspect, what we don't know yet, and what scientists are trying to solve next.</p></div></BaseLayout>
<style>.report-part{padding:28px 0;border-bottom:1px solid var(--border)}.report-part h2{font-family:var(--font-editorial);font-size:30px;font-weight:400;margin:10px 0 18px}.report-part ul{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}.report-part li{font-size:13px;color:var(--accent)}@media(max-width:760px){.report-part ul{grid-template-columns:1fr}}</style>
