---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceCard from '../components/mdx/SourceCard.astro';
import {sourceList} from '../data/sources';
import {categories} from '../data/navigation';
import {evidenceLevels} from '../data/evidence';
const years=[...new Set(sourceList.map(s=>s.year))].sort((a,b)=>b-a);const types=[...new Set(sourceList.map(s=>s.type))];
---
<BaseLayout title="Sources & evidence bibliography" description="Inspect the original guidelines, trials, studies, and official references behind Glucose Atlas, including populations, evidence levels, and limitations."><div class="page-shell"><span class="eyebrow">EVERY CLAIM HAS A TRAIL</span><h1 class="page-title">Go straight to the source.</h1><p class="page-description">{sourceList.length} references. Clinical guidelines for care, original studies for specific findings, and explicit limitations for both.</p><p class="article-notice">For living institutional resources, 2026 may indicate the access year; each source’s limitations explain this. Editorial evidence labels are not formal GRADE assessments. <a href="/about">Read the methodology →</a></p><div class="filter-bar"><label>Topic<select id="source-topic"><option value="">All topics</option>{categories.map(c=><option value={c.key}>{c.label}</option>)}</select></label><label>Year<select id="source-year"><option value="">Any year</option>{years.map(y=><option>{y}</option>)}</select></label><label>Source type<select id="source-type"><option value="">Any type</option>{types.map(t=><option>{t}</option>)}</select></label><label>Evidence<select id="source-evidence"><option value="">Any evidence</option>{evidenceLevels.map(e=><option>{e}</option>)}</select></label></div><p class="filter-count" id="source-count" role="status">{sourceList.length} references</p><div class="bibliography">{sourceList.sort((a,b)=>b.year-a.year).map(source=><SourceCard id={source.id} bibliography/>)}</div></div><script>
const controls=['topic','year','type','evidence'].map(k=>document.getElementById(`source-${k}`) as HTMLSelectElement);function filter(){let count=0;document.querySelectorAll<HTMLElement>('.bibliography .source-card').forEach(card=>{const values=[card.dataset.sourceTopics?.split(' ')||[],[card.dataset.sourceYear],[card.dataset.sourceType],[card.dataset.sourceEvidence]];const show=controls.every((c,i)=>!c.value||values[i].includes(c.value));card.hidden=!show;if(show)count++;});document.getElementById('source-count')!.textContent=`${count} references`;};controls.forEach(c=>c.addEventListener('change',filter));
</script></BaseLayout>
