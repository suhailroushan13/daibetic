---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import {categories} from '../data/navigation';
---
<BaseLayout title="Search the research library" description="Search diabetes biology, clinical tests, prevention, remission, treatments, glossary terms, and emerging research with local full-text search." noindex><div class="page-shell"><span class="eyebrow">ASK A QUESTION. FOLLOW THE EVIDENCE.</span><h1 class="page-title">What would you like<br/>to understand?</h1><p class="page-description">Search the existing library. Results take you to cited research, with no generated medical answers.</p><section class="search-page" aria-label="Search library"><form class="search-form" action="/search" role="search"><Icon name="search"/><label for="full-query" class="sr-only">Search terms</label><input id="full-query" type="search" name="q" placeholder="What is insulin resistance?" autocomplete="off"/><button class="button button-primary" type="submit">Search</button></form><div class="filter-bar"><label>Research area<select id="search-category"><option value="">All areas</option>{categories.map(c=><option value={c.label}>{c.label}</option>)}</select></label></div><div id="full-status" class="search-status" role="status">Search concepts, biology, therapies, and sources.</div><div id="full-results" class="search-results"></div><noscript><p>Search requires JavaScript. <a href="/research">Browse all research topics</a> or use the <a href="/glossary">glossary</a>.</p></noscript></section><div class="related-topics"><h2>Popular starting questions · editorial selections</h2><div class="related-grid"><a href="/fundamentals/insulin">What does insulin actually do? →</a><a href="/type-2/remission">Is remission the same as a cure? →</a><a href="/detection/hba1c">What does an HbA1c test measure? →</a><a href="/future/stem-cells">Can new beta cells treat Type 1? →</a></div></div></div><script>import {initializeSearch} from '../lib/search';const query=document.getElementById('full-query') as HTMLInputElement;query.value=new URLSearchParams(location.search).get('q')||'';initializeSearch('full-query','full-results','full-status','search-category');</script></BaseLayout>
