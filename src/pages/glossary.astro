---
import BaseLayout from '../layouts/BaseLayout.astro';
import {glossary} from '../data/glossary';
---
<BaseLayout title="The diabetes glossary" description="Plain-language definitions of insulin resistance, beta cells, HbA1c, ketones, metabolic terms, and research terminology, linked to deeper explanations."><div class="page-shell" data-pagefind-body><span class="eyebrow" data-pagefind-meta="category">Glossary</span><h1 class="page-title" data-pagefind-meta="title">Science, in plain language.</h1><p class="page-description">{glossary.length} concepts to help you read with confidence. A definition is the beginning of understanding, not the end.</p><div class="filter-bar" data-pagefind-ignore><label>Find a term<input type="search" id="glossary-filter" placeholder="Try “C-peptide”…"/></label><span id="glossary-count" class="filter-count" role="status">{glossary.length} terms</span></div><div class="glossary-grid">{glossary.map(entry=><article class="glossary-entry" data-term={entry.term.toLowerCase()}><h2 id={entry.term.toLowerCase().replace(/[^a-z0-9]+/g,'-')}>{entry.term}</h2><p>{entry.definition}</p><a href={`/${entry.topic}`}>Explore the concept →</a><span> &nbsp; </span><a href={`/sources#${entry.source}`}>Source ↗</a></article>)}</div></div><script>const input=document.querySelector<HTMLInputElement>('#glossary-filter');input?.addEventListener('input',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-term]').forEach(el=>{el.hidden=!el.textContent?.toLowerCase().includes(input.value.toLowerCase());if(!el.hidden)count++;});document.getElementById('glossary-count')!.textContent=`${count} terms`;});</script></BaseLayout>
